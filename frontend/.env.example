# In production (Docker), leave unset — containers are proxied automatically.
# In local dev, set to direct service URLs.
VITE_API_BASE=/core-api
VITE_VIDEO_BASE=/video-api
VITE_AGENT_BASE=/agent-api
VITE_PLATFORM_BASE=/platform-api

# OAuth
VITE_OAUTH_REDIRECT=http://localhost:3000/oauth/callback
VITE_YOUTUBE_CLIENT_ID=
VITE_FB_APP_ID=
VITE_IG_CLIENT_ID=
VITE_LI_CLIENT_ID=
VITE_TWITTER_KEY=
VITE_TIKTOK_KEY=
