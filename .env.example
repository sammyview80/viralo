# ── Core ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://viralo:viralo@postgres:5432/viralo
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://viralo:viralo@rabbitmq:5672//

# ── Security ──────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-256-bit-hex-key
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-fernet-key

# ── LLM Providers ─────────────────────────────────────────────────────────
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ── Storage ───────────────────────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CF_R2_ENDPOINT=https://account_id.r2.cloudflarestorage.com
CF_R2_ACCESS_KEY=
CF_R2_SECRET_KEY=
CF_R2_BUCKET=viralo-videos
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=viralo-videos
AWS_S3_REGION=us-east-1

# ── External APIs ─────────────────────────────────────────────────────────
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── OAuth ─────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

# ── Email / SMTP ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@viralo.app

# ── App Config ────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
APP_DOMAIN=localhost
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
