# ── Core ──────────────────────────────────────────────────────────────────
# NOTE: DATABASE_URL and RABBITMQ_URL passwords below must match
# POSTGRES_PASSWORD / RABBITMQ_PASS exactly (containers don't cross-substitute
# .env values). scripts/install.sh generates and wires all of these for you.
POSTGRES_USER=viralo
POSTGRES_PASSWORD=change-me-strong-password
RABBITMQ_USER=viralo
RABBITMQ_PASS=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://viralo:change-me-strong-password@postgres:5432/viralo
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://viralo:change-me-strong-password@rabbitmq:5672//

# ── Security ──────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-256-bit-hex-key
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-fernet-key
# Signs admin-panel JWTs — MUST be a distinct random value from SECRET_KEY
# (never derived from it). Admin login/verify return HTTP 500 until this is set.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_JWT_SECRET=
# Signs/verifies WebSub (PubSubHubbub) callback payloads. MUST be >= 32 bytes
# or platform-service and celery-video-generate refuse to start.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
WEBSUB_SECRET=

# ── LLM Providers ─────────────────────────────────────────────────────────
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── Storage ───────────────────────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CF_R2_ENDPOINT=https://account_id.r2.cloudflarestorage.com
CF_R2_ACCESS_KEY=
CF_R2_SECRET_KEY=
CF_R2_BUCKET=viralo-videos
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=viralo-videos
AWS_S3_REGION=us-east-1

# ── External APIs ─────────────────────────────────────────────────────────
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── OAuth ─────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

# ── Email / SMTP ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@viralo.app

# ── App Config ────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
APP_DOMAIN=localhost
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Self-hosted install: removes all plan/billing gating (unlimited videos,
# storage, brainstorm, workflows, channels, integrations — no Stripe/eSewa
# checkout). scripts/install.sh sets this to true automatically. Leave unset
# (or false) only if you're running this as a hosted multi-tenant SaaS with
# real billing tiers.
SELF_HOSTED=true

# ── yt-dlp / YouTube Download ─────────────────────────────────────────────
YTDLP_COOKIES_FILE=            # path to yt-dlp cookies file (e.g. /app/yt-cookies.txt)
YTDLP_PROXY=                   # single proxy (e.g. socks5://user:pass@host:port or http://host:port)
YTDLP_PROXY_LIST=              # comma-separated proxies; rotated per strategy on 429
